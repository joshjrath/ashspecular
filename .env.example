# Every setting the bot and the board read. Copy to .env for local use; on
# Railway set them under the service's Variables. Only DATABASE_URL,
# DASHBOARD_PASSWORD and DISCORD_TOKEN are needed to run it all; everything
# else has a default or turns its feature off when empty.
#
# Never commit .env. Values here are placeholders.

# ── Discord ───────────────────────────────────────────────────────────────
# Developer portal → your app → Bot → Reset Token
DISCORD_TOKEN=

# Channels the bot should read, comma separated. Turn on Developer Mode in
# Discord (Settings → Advanced), then right-click a channel → Copy Channel ID.
# Leave empty while testing and it listens in every channel it can see.
INTAKE_CHANNEL_IDS=

# The to-do channel: forward anything there and it becomes a task on the
# board's Tasks page. Unset, a channel named #tasks is used.
TASKS_CHANNEL_IDS=

# The channel the 8am digest and the overdue nudges are posted into. Leave
# empty for neither.
DIGEST_CHANNEL_ID=
# When the digest goes out, in ORG_TZ. Default 8am daily.
DIGEST_CRON=0 8 * * *
# How many long-form priorities it names.
DIGEST_COUNT=4
# How often to check for anything newly past its deadline. Posts once per
# item. Empty turns it off.
NUDGE_CRON=5 * * * *

# Where a video breaking out (well above its channel's usual) is announced:
# a Discord webhook URL, or a channel the bot can post in. Empty: no alerts.
BREAKOUT_WEBHOOK_URL=
BREAKOUT_CHANNEL_ID=

# ── The board ─────────────────────────────────────────────────────────────
# Postgres. Unset means the bot parses and replies but stores nothing, and the
# board has nothing to show. Railway fills this in when you add Postgres.
DATABASE_URL=

# Required to run the board — it shows the whole studio's work, so it will not
# start without one. Can be changed later in Settings → Login password.
DASHBOARD_PASSWORD=
# Signs sign-ins and encrypts the API keys saved in Settings. Set it to a long
# random value (e.g. `openssl rand -base64 32`). Unset, DASHBOARD_PASSWORD is
# used, and changing that would sign everyone out and lose the saved keys.
SESSION_SECRET=
# Forgot the password changed in Settings? Set to true and redeploy: it goes
# back to DASHBOARD_PASSWORD. Remove it again once you're in.
DASHBOARD_PASSWORD_RESET=

# The board's public address (https://…), used to link each Discord reply to
# its record and to build the calendar feed's link.
PUBLIC_URL=
# Railway sets this. Locally the board is at http://localhost:8080.
PORT=8080
# Empty runs everything in one process (the usual). "bot" or "web" splits it
# across two services.
SERVICE=

# A fixed key for the Google Calendar feed's link. Unset, one is derived from
# SESSION_SECRET.
CALENDAR_FEED_KEY=

# ── API keys ──────────────────────────────────────────────────────────────
# All three can also be set, tested and changed in the board's
# Settings → Connections & API keys, which takes over from these.
#
# Claude. OPTIONAL. Assignment posts are read by pattern and never hit the
# API; without a key, messy forwards fall back to rules and the AI features
# (Story Lab ideas, Idea Feed analysis, Competitors' concepts) stay off.
ANTHROPIC_API_KEY=
# YouTube Data API v3 (Google Cloud → Credentials). Several keys, comma
# separated, share the daily quota: when one runs out the next is used.
YOUTUBE_API_KEY=
# Tumblr: an app's OAuth consumer key (tumblr.com/oauth/apps), never its secret.
TUMBLR_API_KEY=
# Google sign-in for YouTube Analytics (Network Overview's real views and
# revenue): an OAuth "Web application" client from Google Cloud → Google Auth
# Platform → Clients. Can be set in Settings → Network & revenue instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The Claude model for every feature. Unset: claude-opus-5 for intake,
# revisions, finance and compilations; claude-opus-5-5 for the Idea Feed,
# Competitors and Story Lab. A feature's own variable overrides it for that
# feature alone.
ANTHROPIC_MODEL=
IDEAS_MODEL=
COMPETITORS_MODEL=
STORYLAB_MODEL=
# Story Lab's Claude calls a day (also in Settings → Limits & spending).
STORYLAB_AI_DAILY=30

# ── Frame.io and the scripts board ────────────────────────────────────────
# A Frame.io developer token, to read a cut's comments for its summary.
# Without it, comments are pasted in by hand.
FRAMEIO_TOKEN=
# "off" stops the bot opening Frame.io links to read their names.
FRAMEIO_LOOKUP=
# The scriptwriter's board, shown under a Scripts tab, and its view-only
# password (its SCRIPTCHECK_VIEW_TOKEN). Unset hides the tab.
SCRIPTS_URL=
SCRIPTS_TOKEN=

# ── Dates ─────────────────────────────────────────────────────────────────
# The zone your deadlines are written in, and the second zone shown alongside.
ORG_TZ=America/New_York
TEAM_TZ=Asia/Kolkata
# Air date minus this many days = the VO deadline, when the post doesn't say.
VO_BUFFER_DAYS=6
DEADLINE_TIME=23:59
# A revision with no deadline is due for review this many hours after it's filed.
REVIEW_HOURS=12

# ── Development only ──────────────────────────────────────────────────────
# Point the integrations at stand-ins, and run the background jobs faster.
# Leave unset in production.
# ANTHROPIC_BASE_URL=
# YOUTUBE_API_BASE=
# TUMBLR_API_BASE=
# IDEAS_TICK_MS=
# STORYLAB_AI_TICK_MS=
# COMPETITORS_TICK_MS=

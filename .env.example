# ---- Discord ----
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# Application ID from the same page (General Information)
DISCORD_APP_ID=

# Channel IDs the bot treats as intake, comma separated.
# Right-click a channel -> Copy Channel ID (Developer Mode must be on).
# Leave empty to listen in every channel the bot can see.
INTAKE_CHANNEL_IDS=

# Where the daily priority digest gets posted. Leave empty to disable the digest.
DIGEST_CHANNEL_ID=

# ---- Claude ----
ANTHROPIC_API_KEY=
# Optional. Default claude-opus-5. claude-haiku-4-5 is ~5x cheaper if you want it.
ANTHROPIC_MODEL=claude-opus-5

# ---- Postgres ----
# Railway injects this automatically when you add a Postgres service.
DATABASE_URL=

# ---- Dashboard ----
# Password for the website. Pick something long.
DASHBOARD_PASSWORD=
# Public URL of the dashboard, e.g. https://ashspecular.up.railway.app
# Used to put clickable board links in the Discord confirmations.
PUBLIC_URL=
# Optional. Defaults to DASHBOARD_PASSWORD. Change it to sign everyone out.
SESSION_SECRET=
PORT=8080

# ---- Scheduling ----
# IANA timezone. This is how "VO by 3pm" and "due today" get resolved — set it.
TIMEZONE=America/New_York
# When the daily digest posts, in the timezone above. Default 08:00 daily.
DIGEST_CRON=0 8 * * *
# How many long-form priorities the digest highlights.
DIGEST_COUNT=4

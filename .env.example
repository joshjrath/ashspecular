# ── Discord ───────────────────────────────────────────────────────────────
# Developer portal → your app → Bot → Reset Token
DISCORD_TOKEN=

# Channels the bot should read, comma separated. Turn on Developer Mode in
# Discord (Settings → Advanced), then right-click a channel → Copy Channel ID.
# Leave empty while testing and it listens in every channel it can see.
INTAKE_CHANNEL_IDS=

# ── Claude ────────────────────────────────────────────────────────────────
# OPTIONAL. Assignment posts are read by pattern and never hit the API. This
# is only for messy forwards and one-liners; leave it empty and those fall
# back to rules rather than being dropped.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ── The board ─────────────────────────────────────────────────────────────
# Postgres. Unset means the bot parses and replies but stores nothing, and the
# board has nothing to show. Railway fills this in for you when you add a
# Postgres service to the project.
DATABASE_URL=

# Required to run the board — it shows the whole studio's work, so it will not
# start without one.
DASHBOARD_PASSWORD=

# The board's public address, used to link each Discord reply to its record.
PUBLIC_URL=

# The channel the 8am digest is posted into. Leave empty for no digest.
DIGEST_CHANNEL_ID=
# When it goes out, in the zone below. Default 8am daily.
DIGEST_CRON=0 8 * * *
# How many long-form priorities it names.
DIGEST_COUNT=4

# ── Dates ─────────────────────────────────────────────────────────────────
# The zone your deadlines are written in, and the second zone shown alongside.
ORG_TZ=America/New_York
TEAM_TZ=Asia/Kolkata
# Air date minus this many days = the VO deadline, when the post doesn't say.
VO_BUFFER_DAYS=6
DEADLINE_TIME=23:59

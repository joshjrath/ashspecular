{
  "name": "ashspecular",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Discord intake bot + single-pane dashboard for four content business lines",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "node dist/db/migrate.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eval": "tsx scripts/eval.ts",
    "parse": "tsx scripts/parse.ts",
    "test:rules": "tsx scripts/test-rules.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "discord.js": "^14.16.3",
    "fastify": "^5.2.1",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
